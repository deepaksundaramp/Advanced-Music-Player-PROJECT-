    def remove_song(self):
        selection = self.playlist_tree.selection()
        if selection:
            index = self.playlist_tree.index(selection[0])
            self.playlist.pop(index)
            self.update_playlist_display()
            
    def move_song_up(self):
        selection = self.playlist_tree.selection()
        if selection and len(selection) == 1:
            index = self.playlist_tree.index(selection[0])
            if index > 0:
                # Swap songs
                self.playlist[index], self.playlist[index-1] = self.playlist[index-1], self.playlist[index]
                self.update_playlist_display()
                # Reselect the moved song
                items = self.playlist_tree.get_children()
                self.playlist_tree.selection_add(items[index-1])
                
    def move_song_down(self):
        selection = self.playlist_tree.selection()
        if selection and len(selection) == 1:
            index = self.playlist_tree.index(selection[0])
            if index < len(self.playlist) - 1:
                # Swap songs
                self.playlist[index], self.playlist[index+1] = self.playlist[index+1], self.playlist[index]
                self.update_playlist_display()
                # Reselect the moved song
                items = self.playlist_tree.get_children()
                self.playlist_tree.selection_add(items[index+1])
                
    def update_thread(self):
        def update():
            while True:
                if self.is_playing and not self.is_paused:
                    # Update progress
                    self.current_position += 0.1
                    if self.total_duration > 0:
                        progress_percent = (self.current_position / self.total_duration) * 100
                        self.progress.set(progress_percent)
                        self.current_time.config(text=self.format_duration(self.current_position))
                        
                    # Check if song ended
                    if self.current_position >= self.total_duration:
                        self.handle_song_end()
                        
                time.sleep(0.1)
                
        thread = threading.Thread(target=update, daemon=True)
        thread.start()
        
    def handle_song_end(self):
        if self.repeat_mode == "one":
            self.play_current_song()
        elif self.repeat_mode == "all" or self.current_index < len(self.playlist) - 1:
            self.next_song()
        else:
            self.stop_music()
            
