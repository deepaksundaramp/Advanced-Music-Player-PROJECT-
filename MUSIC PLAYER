    # Music control methods
    def add_songs(self):
        files = filedialog.askopenfilenames(
            title="Select Music Files",
            filetypes=(
                ("Audio Files", "*.mp3 *.wav *.ogg *.flac"),
                ("MP3 Files", "*.mp3"),
                ("WAV Files", "*.wav"), 
                ("All Files", "*.*")
            )
        )
        
        new_songs = []
        for file_path in files:
            song = self.get_song_info(file_path)
            if song:
                self.playlist.append(song)
                new_songs.append(song)
                
        if new_songs:
            self.update_playlist_display()
            self.status_text.config(text=f"Added {len(new_songs)} songs to playlist")
            
    def get_song_info(self, file_path: str) -> Optional[Song]:
        try:
            audio_file = File(file_path)
            song = Song(path=file_path)
            
            # Get metadata
            if audio_file is not None:
                if hasattr(audio_file, 'tags') and audio_file.tags is not None:
                    tags = audio_file.tags
                    song.title = str(tags.get('title', [os.path.basename(file_path)]))[0]
                    song.artist = str(tags.get('artist', ['Unknown Artist']))[0]
                    song.album = str(tags.get('album', ['Unknown Album']))[0]
                    song.year = str(tags.get('date', ['']))[0]
                else:
                    # Fallback to filename
                    filename = os.path.basename(file_path)
                    song.title = os.path.splitext(filename)[0]
                    song.artist = "Unknown Artist"
                    song.album = "Unknown Album"
                    
                song.duration = audio_file.info.length
            else:
                return None
                
            return song
            
        except Exception as e:
            print(f"Error reading file {file_path}: {e}")
            return None
            
    def update_playlist_display(self):
        # Clear existing items
        for item in self.playlist_tree.get_children():
            self.playlist_tree.delete(item)
            
        # Add songs to treeview
        for i, song in enumerate(self.playlist, 1):
            duration = self.format_duration(song.duration)
            self.playlist_tree.insert('', 'end', values=(
                i, song.title, song.artist, song.album, duration
            ))
            
    def format_duration(self, seconds: float) -> str:
        if seconds == 0:
            return "0:00"
        minutes = int(seconds // 60)
        seconds = int(seconds % 60)
        return f"{minutes}:{seconds:02d}"
        
    def on_song_double_click(self, event):
        selection = self.playlist_tree.selection()
        if selection:
            index = self.playlist_tree.index(selection[0])
            self.current_index = index
            self.play_current_song()
            
    def play_current_song(self):
        if not self.playlist:
            return
            
        try:
            song = self.playlist[self.current_index]
            pygame.mixer.music.load(song.path)
            pygame.mixer.music.play()
            
            self.is_playing = True
            self.is_paused = False
            self.total_duration = song.duration
            self.current_position = 0.0
            
            # Update UI
            self.song_title.config(text=song.title)
            self.song_artist.config(text=song.artist)
            self.song_album.config(text=song.album)
            self.total_time.config(text=self.format_duration(song.duration))
            
            # Highlight current song
            self.highlight_current_song()
            
            self.status_text.config(text=f"Now playing: {song.title}")
            
        except pygame.error as e:
            messagebox.showerror("Playback Error", f"Cannot play file: {e}")
            
    def toggle_play_pause(self):
        if not self.playlist:
            return
            
        if self.is_playing and not self.is_paused:
            pygame.mixer.music.pause()
            self.is_paused = True
            self.status_text.config(text="Playback paused")
        elif self.is_paused:
            pygame.mixer.music.unpause()
            self.is_paused = False
            self.status_text.config(text="Playback resumed")
        else:
            self.play_current_song()
            
    def stop_music(self):
        pygame.mixer.music.stop()
        self.is_playing = False
        self.is_paused = False
        self.current_position = 0.0
        self.progress.set(0)
        self.status_text.config(text="Playback stopped")
        
    def next_song(self):
        if not self.playlist:
            return
            
        if self.shuffle:
            self.current_index = random.randint(0, len(self.playlist) - 1)
        else:
            self.current_index = (self.current_index + 1) % len(self.playlist)
            
        self.play_current_song()
        
    def previous_song(self):
        if not self.playlist:
            return
            
        self.current_index = (self.current_index - 1) % len(self.playlist)
        self.play_current_song()
        
    def highlight_current_song(self):
        # Clear previous selection
        for item in self.playlist_tree.selection():
            self.playlist_tree.selection_remove(item)
            
        # Select current song
        if self.playlist_tree.get_children():
            items = self.playlist_tree.get_children()
            if 0 <= self.current_index < len(items):
                self.playlist_tree.selection_add(items[self.current_index])
                self.playlist_tree.focus(items[self.current_index])
                
    def seek_to_position(self, value):
        if self.is_playing and self.total_duration > 0:
            position = float(value) / 100 * self.total_duration
            pygame.mixer.music.set_pos(position)
            self.current_position = position
            
    def set_volume(self, value):
        self.volume = float(value) / 100
        pygame.mixer.music.set_volume(self.volume)
        
        # Update volume icon
        if self.volume == 0:
            self.volume_btn.config(text="🔇")
        elif self.volume < 0.3:
            self.volume_btn.config(text="🔈")
        elif self.volume < 0.7:
            self.volume_btn.config(text="🔉")
        else:
            self.volume_btn.config(text="🔊")
            
    def toggle_mute(self):
        if self.volume > 0:
            self.last_volume = self.volume
            self.volume_scale.set(0)
        else:
            self.volume_scale.set(self.last_volume * 100)
            
    def cycle_repeat_mode(self):
        modes = ["off", "one", "all"]
        current_index = modes.index(self.repeat_mode)
        self.repeat_mode = modes[(current_index + 1) % len(modes)]
        
        # Update UI
        self.repeat_label.config(text=self.repeat_mode.capitalize())
        
        colors = {"off": "#404040", "one": "#e74c3c", "all": "#3498db"}
        self.repeat_btn.config(bg=colors[self.repeat_mode])
        
    def toggle_shuffle(self):
        self.shuffle = not self.shuffle
        color = "#3498db" if self.shuffle else "#404040"
        self.status_text.config(text=f"Shuffle: {'ON' if self.shuffle else 'OFF'}")
        
    def set_equalizer_band(self, band: str, value: float):
        self.equalizer[band] = value
